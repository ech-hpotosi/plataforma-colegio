# Copiar como .env en esta misma carpeta y completar. El archivo .env no se sube al repositorio.

# Dominio que apunta a la IP del servidor (registro A del DNS)
DOMINIO=plataforma.ejemplo.edu.co

# Contrasena de la base de datos: larga y aleatoria (por ejemplo: openssl rand -base64 24)
DB_CONTRASENA=

# Primer administrador. Solo se usa la primera vez, cuando no existe ningun administrador.
# Despues de ingresar y cambiar la contrasena se puede borrar este valor.
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=
