# DOMINIO viene del archivo .env (por ejemplo plataforma.iemelencano.edu.co).
# Caddy obtiene y renueva solo el certificado HTTPS de Let's Encrypt.
{$DOMINIO} {
	encode zstd gzip

	# La API va al backend; el resto es la aplicacion web
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# Las rutas de React (/estudiantes, /familia, ...) se resuelven en el navegador
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
